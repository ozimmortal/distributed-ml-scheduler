{
  "name": "distributed-ml-scheduler",
  "private": true,
  "workspaces": [
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "dev:gateway": "bun run --cwd services/gateway dev",
    "dev:worker": "bun run --cwd services/worker dev",
    "dev:scheduler": "bun run --cwd services/scheduler dev",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.5"
  }
}
